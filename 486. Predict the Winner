class Solution {
public:
    bool predictTheWinner(vector<int>& num) {
        int n = num.size();
        if (n%2==0) return true;
        vector<int> d(num);
        for(int i=n-2;i>=0;--i){
            for(int j=i+1;j<n;++j){
                d[j]=max(num[i]-d[j],num[j]-d[j-1]);
            }
        }
        return d[n-1]>=0;
    }
};

